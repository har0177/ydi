# CodeIgniter Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Security - Block sensitive files
<FilesMatch "(^\.env|\.htaccess|\.git)">
    Require all denied
</FilesMatch>
