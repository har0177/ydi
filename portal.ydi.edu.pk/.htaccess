# CodeIgniter Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Security - Block sensitive files
<FilesMatch "(^\.env|\.htaccess|\.git)">
    Require all denied
</FilesMatch>

# CSP override — the server-level CSP blocks our jQuery/Bootstrap/FA/Pusher/profile-image
# CDNs, which breaks tab switching and the entire layout. Replace it with a value that
# whitelists the third parties this app actually uses.
<IfModule mod_headers.c>
    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://ajax.googleapis.com https://maxcdn.bootstrapcdn.com https://use.fontawesome.com https://js.pusher.com https://cdn.jsdelivr.net https://unpkg.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://maxcdn.bootstrapcdn.com https://use.fontawesome.com https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://use.fontawesome.com https://maxcdn.bootstrapcdn.com; img-src 'self' data: https://mis.ydi.edu.pk https://img.youtube.com https://*.ytimg.com; connect-src 'self' wss://*.pusher.com https://*.pusher.com https://stats.pusher.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com"
</IfModule>
